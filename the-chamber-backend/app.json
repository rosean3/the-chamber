{
  "name": "the-chamber-backend",
  "description": "Backend API para The Chamber - Experimento Individual",
  "repository": "https://github.com/seu-usuario/the-chamber",
  "logo": "https://node-js-sample.herokuapp.com/node.png",
  "keywords": ["node", "express", "google-sheets", "experiment"],
  "env": {
    "NODE_ENV": {
      "description": "Ambiente de execução",
